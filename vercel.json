{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/ejecucion/PROTOTIPO_DASHBOARD_VENTAS_QALIKAY.html" },
    { "source": "/xlsx.full.min.js", "destination": "/ejecucion/xlsx.full.min.js" },
    { "source": "/data/datos_comerciales.json", "destination": "/data/datos_comerciales.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
